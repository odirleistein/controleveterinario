# Copie este arquivo para ".env" e ajuste a senha do banco.
# NUNCA versione o arquivo ".env" real no Git (contem a senha do banco).
DATABASE_URL=postgresql+psycopg2://postgres:SUASENHA@localhost:5432/controleveterinario

# Gere uma chave propria com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_a_sua_com_python_c_import_secrets_print_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480
